# Copy to secrets.toml for local runs, or paste into Streamlit Cloud -> App settings -> Secrets
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_KEY = "your-secret-key"
APP_PASSWORD = "pick-a-password"
# Optional: free key from hunter.io (25 lookups/month) to find emails for people at a company
HUNTER_API_KEY = "your-hunter-key"
